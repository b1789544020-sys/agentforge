# Local development defaults. Docker Compose supplies its own PostgreSQL URL.
AGENTFORGE_LLM_PROVIDER=mock
AGENTFORGE_AUTH_ENABLED=false
# Required by Docker Compose; replace with a long random value, never reuse it.
AGENTFORGE_SECRET_KEY=replace-with-a-long-random-secret
# Optional independent Fernet key for sensitive Agent configuration.
# AGENTFORGE_ENCRYPTION_KEY=
AGENTFORGE_SANDBOX_REQUIRED=false
# DOCKER_GID=999
AGENTFORGE_API_TOKEN=
AGENTFORGE_ENABLE_DANGEROUS_TOOLS=false
AGENTFORGE_FILE_ALLOWED_DIRS=[]
AGENTFORGE_HTTP_ALLOWED_HOSTS=[]
AGENTFORGE_EMBEDDING_PROVIDER=hashing
AGENTFORGE_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
AGENTFORGE_EMBEDDING_LOCAL_FILES_ONLY=true
AGENTFORGE_VECTOR_BACKEND=inprocess
AGENTFORGE_VECTOR_URL=http://localhost:6333
# Local defaults are memory; Docker Compose overrides these to celery/redis.
# AGENTFORGE_TASK_BACKEND=memory
# AGENTFORGE_CONTROL_BACKEND=memory
AGENTFORGE_REDIS_URL=redis://localhost:6379/0
# Public delivery: 60 requests/minute per token and per client IP; 0 disables.
AGENTFORGE_DELIVERY_RATE_LIMIT_REQUESTS=60
AGENTFORGE_DELIVERY_RATE_LIMIT_WINDOW_SECONDS=60
AGENTFORGE_DELIVERY_RATE_LIMIT_BACKEND=auto
AGENTFORGE_DELIVERY_RATE_LIMIT_FAIL_CLOSED=true
# Trust X-Forwarded-For only from these proxy IPs/CIDRs, for example ["10.0.0.0/8"].
AGENTFORGE_DELIVERY_TRUSTED_PROXIES=[]
# Public iframe parents; replace * with explicit origins before public exposure.
AGENTFORGE_FRAME_ANCESTORS=*
# AGENTFORGE_DATABASE_URL=sqlite+aiosqlite:///./agentforge.db
# AGENTFORGE_OPENAI_API_KEY=
# AGENTFORGE_ANTHROPIC_API_KEY=
# AGENTFORGE_KIMI_API_KEY=
# AGENTFORGE_GLM_API_KEY=
# AGENTFORGE_DOUBAO_API_KEY=

# Optional local OpenAI-compatible defaults; per-Agent config.base_url takes precedence.
# AGENTFORGE_OLLAMA_BASE_URL=http://localhost:11434/v1
# AGENTFORGE_VLLM_BASE_URL=http://localhost:8001/v1

# Set to the same non-empty value as AGENTFORGE_API_TOKEN when API auth is on.
VITE_API_TOKEN=
