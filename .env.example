# Local development defaults. Docker Compose supplies its own PostgreSQL URL.
AGENTFORGE_LLM_PROVIDER=mock
AGENTFORGE_API_TOKEN=
AGENTFORGE_ENABLE_DANGEROUS_TOOLS=false
AGENTFORGE_FILE_ALLOWED_DIRS=[]
AGENTFORGE_HTTP_ALLOWED_HOSTS=[]
AGENTFORGE_EMBEDDING_PROVIDER=hashing
AGENTFORGE_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
AGENTFORGE_EMBEDDING_LOCAL_FILES_ONLY=true
AGENTFORGE_VECTOR_BACKEND=inprocess
AGENTFORGE_VECTOR_URL=http://localhost:6333
# Local defaults are memory; Docker Compose overrides these to celery/redis.
# AGENTFORGE_TASK_BACKEND=memory
# AGENTFORGE_CONTROL_BACKEND=memory
AGENTFORGE_REDIS_URL=redis://localhost:6379/0
# AGENTFORGE_DATABASE_URL=sqlite+aiosqlite:///./agentforge.db
# AGENTFORGE_OPENAI_API_KEY=
# AGENTFORGE_ANTHROPIC_API_KEY=
# AGENTFORGE_KIMI_API_KEY=
# AGENTFORGE_GLM_API_KEY=
# AGENTFORGE_DOUBAO_API_KEY=

# Set to the same non-empty value as AGENTFORGE_API_TOKEN when API auth is on.
VITE_API_TOKEN=
