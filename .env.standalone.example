# Zero-external-service development/edge profile; same application code.
AGENTFORGE_DATABASE_URL=sqlite+aiosqlite:///./backend/agentforge.db
AGENTFORGE_TASK_BACKEND=memory
AGENTFORGE_CONTROL_BACKEND=memory
AGENTFORGE_VECTOR_BACKEND=inprocess
AGENTFORGE_EMBEDDING_PROVIDER=hashing
AGENTFORGE_EMBEDDING_LOCAL_FILES_ONLY=true
AGENTFORGE_LLM_PROVIDER=mock
AGENTFORGE_AUTH_ENABLED=false
AGENTFORGE_SANDBOX_REQUIRED=false
AGENTFORGE_ENABLE_DANGEROUS_TOOLS=false
AGENTFORGE_SECRET_KEY=replace-with-a-long-random-local-secret
# Optional independent Fernet key for sensitive Agent config.
# AGENTFORGE_ENCRYPTION_KEY=
